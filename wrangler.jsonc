{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "guardian",
  "main": "./worker/index.js",
  "compatibility_date": "2026-08-08",

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/api/*",
      "/admin",
      "/admin/*",
      "/products/*",
      "/suggestions",
      "/suggestions/*"
    ],
    "html_handling": "auto-trailing-slash"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hamood-labs",
      "database_id": "1a34c34f-6072-4a68-928b-e5a98676a61b",
      "migrations_dir": "migrations"
    }
  ],

  "vars": {
    "DISCORD_CLIENT_ID": "1535228662641725520"
  }
}